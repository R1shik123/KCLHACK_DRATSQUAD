{
  "$schema": "Signblast recogniser settings. Both the website and the app load these numbers so they accept exactly the same handshapes. Ported from the hackathon app/recognizer.js.",
  "version": "1.1.0",
  "model": {
    "name": "MediaPipe Hand Landmarker (float16)",
    "url": "https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task",
    "numHands": 2,
    "minDetectionConfidence": 0.5,
    "minPresenceConfidence": 0.5,
    "minTrackingConfidence": 0.5
  },
  "features": {
    "order": [
      "thumb",
      "index",
      "middle",
      "ring",
      "pinky",
      "spread"
    ],
    "notes": [
      "All distances are divided by palm size = dist(landmark 0, landmark 9). z is weighted 0.5.",
      "thumb = clamp((dist(4,5)/palm - 0.25) / 0.5)",
      "finger extension = clamp((dist(0,tip)/dist(0,mcp) - 1.1) / 0.75) for (8,5) (12,9) (16,13) (20,17)",
      "spread = clamp((dist(8,12)/palm - 0.15) / 0.3) * min(index, middle)",
      "dTouch = dist(4,12)/palm; up = clamp((y0 - y9)/palm, -1, 1); thumbToN = dist(4,N)/palm for N in 6,8,9,10,13",
      "tipsToThumb = mean of dist(4,k)/palm for k in 8,12,16,20; crossed = (x8 - x12) * (x6 - x10) < 0"
    ]
  },
  "weights": [
    0.7,
    1,
    1,
    1,
    1,
    0.6
  ],
  "accept": 0.3,
  "margin": 0.05,
  "stableFrames": 8,
  "rearmFrames": 14,
