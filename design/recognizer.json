  "rules": {
    "$doc": "Extra penalties added to a letter's distance. up/side/down: 0.35 * how far the hand is from upright / sideways / pointing down. near(feature, r): 0.4 * max(0, value - r). touchMax(r, k): max(0, dTouch - r) * k. touchMin(r, k): max(0, r - dTouch) * k. farMin(feature, r, k): max(0, r - value) * k. crossed(p): +p if index and middle cross. notCrossed(p): +p if they don't.",
