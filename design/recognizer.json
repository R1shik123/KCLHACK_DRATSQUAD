  "smoothing": {
    "$doc": "Majority vote over the last `window` classified frames (null counts as a vote). A letter is reported only if it has at least `minVotes`. Reduces flicker between neighbouring shapes.",
    "window": 5,
    "minVotes": 3
  },
  "calibration": {
    "$doc": "Personal model: the player records their own handshape per letter (Learn → letter → Teach it my hand). Stored on the device only. For a calibrated letter, distance = (1 - blend) * templateDistance + blend * knnDistance, where knnDistance is the mean Euclidean distance (weighted like the templates) from the live 6-feature vector to the k nearest recorded samples of that letter, divided by sqrt(sum(weights)). Uncalibrated letters use the template only. accept/margin still apply.",
    "samplesPerLetter": 30,
    "maxSamples": 60,
    "k": 5,
    "blend": 0.6
  }
}