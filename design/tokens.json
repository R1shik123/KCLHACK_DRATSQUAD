{
  "$schema": "Signblast shared design tokens. Single source of truth for the website (web/) and the app (mobile/). Edit here only, then run: node design/build-tokens.mjs",
  "version": "2.1.0",
  "basedOn": "garden-skills web-design-engineer, style recipe apple-hig (Apple Human Interface). v2: grey canvas, white elevated cards, layered shadows.",
  "color": {
    "light": {
      "bg": "#F5F5F7",
      "surface": "#FFFFFF",
      "surfaceHigh": "#FFFFFF",
      "fill": "#EFEFF3",
      "ink": "#1D1D1F",
      "muted": "#6E6E73",
      "hairline": "#E3E3E8",
      "accent": "#0071E3",
      "accentInk": "#FFFFFF",
      "success": "#248A3D",
      "successFill": "#34C759",
      "danger": "#D70015",
      "overlay": "rgba(0, 0, 0, 0.40)"
    },
    "dark": {
      "bg": "#000000",
      "surface": "#161618",
      "surfaceHigh": "#232326",
      "fill": "#26262B",
      "ink": "#F5F5F7",
      "muted": "#8E8E93",
      "hairline": "#2C2C30",
      "accent": "#0A84FF",
      "accentInk": "#FFFFFF",
      "success": "#30D158",
      "successFill": "#30D158",
      "danger": "#FF453A",
      "overlay": "rgba(0, 0, 0, 0.60)"
    }
  },
  "font": {
    "family": "Inter Tight",
    "fallback": [
      "-apple-system",
      "BlinkMacSystemFont",
      "Segoe UI",
      "Roboto",
      "Helvetica Neue",
      "Arial",
      "sans-serif"
    ],
    "source": "Google Fonts (web) / @expo-google-fonts/inter-tight or bundled .ttf (app). Weights 400, 500, 600 only.",
    "numeric": "tabular-nums for every number that changes (timer, score, counts)"
  },
  "type": {
    "hero": {
      "size": 56,
      "line": 58,
      "weight": 600,
      "tracking": -0.04,
      "desktop": {
        "size": 80,
        "line": 80
      }
    },
    "display": {
      "size": 64,
      "line": 68,
      "weight": 600,
      "tracking": -0.03
    },
    "largeTitle": {
      "size": 36,
      "line": 40,
      "weight": 600,
      "tracking": -0.025
    },
    "title1": {
      "size": 28,
      "line": 34,
      "weight": 600,
      "tracking": -0.02
    },
    "title2": {
      "size": 22,
      "line": 28,
      "weight": 600,
      "tracking": -0.01
    },
    "headline": {
      "size": 17,
      "line": 22,
      "weight": 600,
      "tracking": 0
    },
    "body": {
      "size": 17,
      "line": 25,
      "weight": 400,
      "tracking": 0
    },
    "callout": {
      "size": 16,
      "line": 21,
      "weight": 400,
      "tracking": 0
    },
    "subhead": {
      "size": 15,
      "line": 20,
      "weight": 400,
      "tracking": 0
    },
    "footnote": {
      "size": 13,
      "line": 18,
      "weight": 400,
      "tracking": 0
    },
    "eyebrow": {
      "size": 12,
      "line": 16,
      "weight": 600,
      "tracking": 0.06,
      "case": "uppercase"
    }
  },
  "space": {
    "xxs": 4,
    "xs": 8,
    "sm": 16,
    "md": 24,
    "lg": 40,
    "xl": 64,
    "xxl": 96,
    "xxxl": 160
  },
  "radius": {
    "sm": 14,
    "md": 20,
    "lg": 28,
    "pill": 999
  },
  "shadow": {
    "$doc": "Layered shadows. sm = resting cards, md = hover / raised panels, lg = hero demo, sheets. Dark mode swaps drop shadows for a hairline ring + top highlight, since shadows vanish on black. Accent glow = 0 10px 28px -10px accent (computed in CSS).",
    "light": {
      "sm": "0 0.5px 1px rgba(0, 0, 0, 0.04), 0 1px 3px rgba(0, 0, 0, 0.05), 0 4px 10px -4px rgba(0, 0, 0, 0.05)",
      "md": "0 1px 2px rgba(0, 0, 0, 0.04), 0 6px 16px -4px rgba(0, 0, 0, 0.08), 0 18px 36px -18px rgba(0, 0, 0, 0.14)",
      "lg": "0 2px 4px rgba(0, 0, 0, 0.04), 0 14px 30px -8px rgba(0, 0, 0, 0.10), 0 40px 80px -30px rgba(0, 0, 0, 0.22)"
    },
    "dark": {
      "sm": "inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 0 0 1px rgba(255, 255, 255, 0.06), 0 2px 6px rgba(0, 0, 0, 0.5)",
      "md": "inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 0 0 1px rgba(255, 255, 255, 0.08), 0 10px 30px rgba(0, 0, 0, 0.6)",
      "lg": "inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 0 0 1px rgba(255, 255, 255, 0.09), 0 30px 80px rgba(0, 0, 0, 0.7)"
    }
  },
  "size": {
    "button": 48,
    "buttonSmall": 36,
    "row": 56,
    "tabBar": 56,
    "icon": 22,
    "iconStroke": 1.75,
    "holdRingStroke": 6,
    "contentMax": 680,
    "playMax": 560,
    "minTap": 44
  },
  "motion": {
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
    "fast": 200,
    "base": 350,
    "slow": 600,
    "reducedMotion": "No movement over 4 units; keep opacity fades only.",
    "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "doc": "Motion has a job: guide attention (hero, CTA), confirm an action (hit, word done), or show depth (hover lift, tilt). Reduced motion: no movement, fades only."
  },
  "icons": {
    "set": "Lucide (lucide-react on web, lucide-react-native in the app)",
    "map": {
      "tabPlay": "play",
      "tabLearn": "book-open",
      "tabProgress": "chart-no-axes-column",
      "settings": "settings",
      "camera": "camera",
      "close": "x",
      "back": "chevron-left",
      "next": "chevron-right",
      "correct": "check",
      "skip": "skip-forward",
      "hint": "lightbulb",
      "streak": "flame",
      "timer": "timer",
      "sound": "volume-2",
      "soundOff": "volume-x",
      "gameSprint": "zap",
      "gameSpell": "type",
      "gameEcho": "repeat",
      "gameMystery": "circle-help",
      "gameDuel": "swords",
      "gameDaily": "calendar",
      "gamePractice": "target",
      "peek": "eye",
      "heart": "heart",
      "trophy": "trophy",
      "sun": "sun",
      "moon": "moon",
      "palette": "palette",
      "record": "circle-dot"
    }
  },
  "appearance": {
    "options": [
      "system",
      "light",
      "dark"
    ],
    "default": "system",
    "doc": "System follows the device. Light/Dark force a palette. Website: data-theme on <html>."
  },
  "accents": {
    "$doc": "User-selectable accent colour (Settings). Replaces color.accent and color.accentInk. accentSoft = accent at 14% opacity over the background, used for tinted tiles and icon badges. Website: data-accent on <html>. gradientLight/gradientDark: the two stops of the accent gradient (primary button, hero word, hero tile, featured card), at 135deg.",
    "default": "blue",
    "blue": {
      "name": "Blue",
      "light": "#0071E3",
      "dark": "#0A84FF",
      "inkLight": "#FFFFFF",
      "inkDark": "#FFFFFF",
      "gradientLight": [
        "#0071E3",
        "#7B5CFF"
      ],
      "gradientDark": [
        "#0A84FF",
        "#8E6BFF"
      ]
    },
    "indigo": {
      "name": "Indigo",
      "light": "#5856D6",
      "dark": "#5E5CE6",
      "inkLight": "#FFFFFF",
      "inkDark": "#FFFFFF",
