{
  "$schema": "Signblast shared design tokens. Single source of truth for the website (web/) and the app (mobile/). Edit here only, then run: node design/build-tokens.mjs",
  "version": "1.0.0",
  "basedOn": "garden-skills web-design-engineer, style recipe apple-hig (Apple Human Interface)",

  "color": {
    "light": {
      "bg":          "#FFFFFF",
      "surface":     "#F5F5F7",
      "surfaceHigh": "#FFFFFF",
      "ink":         "#1D1D1F",
      "muted":       "#86868B",
      "hairline":    "#D2D2D7",
      "accent":      "#0071E3",
      "accentInk":   "#FFFFFF",
      "success":     "#248A3D",
      "successFill": "#34C759",
      "danger":      "#D70015",
      "overlay":     "rgba(0, 0, 0, 0.40)"
    },
    "dark": {
      "bg":          "#000000",
      "surface":     "#1C1C1E",
      "surfaceHigh": "#2C2C2E",
      "ink":         "#F5F5F7",
      "muted":       "#98989D",
      "hairline":    "#38383A",
      "accent":      "#0A84FF",
      "accentInk":   "#FFFFFF",
      "success":     "#30D158",
      "successFill": "#30D158",
      "danger":      "#FF453A",
      "overlay":     "rgba(0, 0, 0, 0.60)"
    }
  },

  "font": {
    "family": "Inter Tight",
    "fallback": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
    "source": "Google Fonts (web) / @expo-google-fonts/inter-tight or bundled .ttf (app). Weights 400, 500, 600 only.",
    "numeric": "tabular-nums for every number that changes (timer, score, counts)"
  },

  "type": {
    "display":    { "size": 64, "line": 68, "weight": 600, "tracking": -0.02 },
    "largeTitle": { "size": 34, "line": 41, "weight": 600, "tracking": -0.01 },
    "title1":     { "size": 28, "line": 34, "weight": 600, "tracking": -0.01 },
    "title2":     { "size": 22, "line": 28, "weight": 600, "tracking": 0 },
    "headline":   { "size": 17, "line": 22, "weight": 600, "tracking": 0 },
    "body":       { "size": 17, "line": 25, "weight": 400, "tracking": 0 },
    "callout":    { "size": 16, "line": 21, "weight": 400, "tracking": 0 },
    "subhead":    { "size": 15, "line": 20, "weight": 400, "tracking": 0 },
    "footnote":   { "size": 13, "line": 18, "weight": 400, "tracking": 0 },
    "eyebrow":    { "size": 12, "line": 16, "weight": 600, "tracking": 0.06, "case": "uppercase" }
  },

  "space": { "xxs": 4, "xs": 8, "sm": 16, "md": 24, "lg": 40, "xl": 64, "xxl": 96, "xxxl": 160 },

  "radius": { "sm": 12, "md": 18, "lg": 22, "pill": 999 },

  "shadow": {
    "card": { "x": 0, "y": 1, "blur": 2, "color": "rgba(0, 0, 0, 0.04)" }
  },

  "size": {
    "button": 50,
    "buttonSmall": 36,
    "row": 56,
    "tabBar": 56,
    "icon": 22,
    "iconStroke": 1.75,
    "holdRingStroke": 6,
    "contentMax": 680,
    "playMax": 560,
    "minTap": 44
  },

  "motion": {
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
    "fast": 200,
    "base": 350,
    "slow": 600,
    "reducedMotion": "No movement over 4 units; keep opacity fades only."
  },

  "icons": {
    "set": "Lucide (lucide-react on web, lucide-react-native in the app)",
    "map": {
      "tabPlay": "play",
      "tabLearn": "book-open",
      "tabProgress": "chart-no-axes-column",
      "settings": "settings",
      "camera": "camera",
      "close": "x",
      "back": "chevron-left",
      "next": "chevron-right",
      "correct": "check",
      "skip": "skip-forward",
      "hint": "lightbulb",
      "streak": "flame",
      "timer": "timer",
      "sound": "volume-2",
      "soundOff": "volume-x"
    }
  }
}
